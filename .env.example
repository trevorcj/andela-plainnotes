NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Runtime app writes use the user's session and RLS, never a service-role key.
# SUPABASE_DB_URL is only needed for applying migrations with the Supabase CLI.
# Server-only. Never prefix these with NEXT_PUBLIC_ or put them in browser config.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Google Meet REST API & Google Workspace Domain-Wide Delegation
# Option A: Service Account with Domain-Wide Delegation (Enterprise / Workspace)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_WORKSPACE_ADMIN_EMAIL=

# Option B: Standard Google OAuth 2.0 Credentials with Refresh Token
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
